rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────
    // Pattern check replaces hardcoded whitelist — new tools work without a rules deploy.
    // Enforcement is at the API layer (App Check → Enforced), so this just prevents garbage slugs.
    function isValidSlug(slug) {
      return slug.size() >= 2 && slug.size() <= 60 && slug.matches("^[a-z0-9-]{2,60}$");
    }

    // ── User feedback & ratings — anonymous creates only ───────────
    // Reads blocked (view in Console). Schema-validated (no App Check — server-side verification
    // currently fails due to secret/site-key mismatch; re-enable after fixing Firebase Console).
    match /feedback/{docId} {
      allow create: if request.resource.data.keys().hasOnly(["rating","comment","tool","path","url","userAgent","createdAt","clientTimestamp"])
                    && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.comment is string && request.resource.data.comment.size() <= 500
                    && request.resource.data.tool is string && request.resource.data.tool.size() >= 1 && request.resource.data.tool.size() <= 120
                    && request.resource.data.path is string && request.resource.data.path.size() <= 500
                    && request.resource.data.url is string && request.resource.data.url.size() <= 1000
                    && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 500
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.clientTimestamp is string && request.resource.data.clientTimestamp.size() <= 50;
      allow read, update, delete: if false;
    }

    // ── Community tool usage counters — ONE doc per tool ──────────
    // Strategy:
    //  • Whitelisted slug only (prevents arbitrary collection pollution)
    //  • docId MUST == slug, link MUST == "/"+slug (prevents spoof)
    //  • create: count MUST be 1, updatedAt MUST be server time (prevents seeding huge numbers)
    //  • update: count MUST be previous+1 (prevents jump to 1M), other fields immutable, +10M cap
    //  • 2s client throttle in toolUsageService.js
    //  • App Check enforced at API layer (Firebase Console → App Check → Enforce), NOT via request.app
    //    (request.app is Cloud Functions only; in Firestore rules it is always null — see firebase-js-sdk#9914)
    match /tool_usage/{slug} {
      allow read: if true;

      allow create: if slug == request.resource.data.slug
                    && isValidSlug(slug)
                    && request.resource.data.keys().hasOnly(["slug","link","title","count","updatedAt"])
                    && request.resource.data.link == "/" + slug
                    && request.resource.data.slug is string
                    && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120
                    && request.resource.data.count == 1
                    && request.resource.data.updatedAt == request.time;

      allow update: if slug == resource.data.slug
                    && isValidSlug(slug)
                    && request.resource.data.keys().hasOnly(["slug","link","title","count","updatedAt"])
                    && request.resource.data.slug == resource.data.slug
                    && request.resource.data.link == resource.data.link
                    && request.resource.data.title.lower() == resource.data.title.lower()
                    && request.resource.data.count == resource.data.count + 1
                    && request.resource.data.count <= 10000000
                    && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ── Debug collection — no App Check, capped writes ─────────────
    // Allows one create per docId (timestamped). Used to diagnose why
    // App Check tokens fail server-side despite client-side success.
    // Auto-expire by querying & deleting old docs periodically.
    match /_debug/{docId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll(["ts","host","phase","slug","appCheckPresent","tokenLen","error","siteKey","provider","isDev","env"])
                    && request.resource.data.ts is string && request.resource.data.ts.size() <= 40
                    && request.resource.data.host is string && request.resource.data.host.size() <= 100
                    && request.resource.data.phase is string && request.resource.data.phase.size() <= 20
                    && request.resource.data.error is string && request.resource.data.error.size() <= 500;
      allow update, delete: if false;
    }
  }
}
