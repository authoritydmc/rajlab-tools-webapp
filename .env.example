# Firebase — copy to .env.local and fill from Firebase Console
VITE_BRAND_CREDIT=Raj Dubey
VITE_APP_VERSION=2.7.0
VITE_SUPPORT_UPI_ID=rajlabs.in@ybl
VITE_SUPPORT_UPI_NAME=Rajlabs
VITE_CASHFREE_URL=https://payments.cashfree.com/forms/rajdubey
VITE_BMC_URL=https://buymeacoffee.com/rajlabs.in

# App Check — reCAPTCHA Enterprise (invisible, non-invasive)
# Create key: Google Cloud Console → Security → reCAPTCHA Enterprise → Create key (Score-based, allow your domains)
# Then: Firebase Console → App Check → Apps → rajlabs-tools-webapp → reCAPTCHA Enterprise → paste Site Key
# For local dev, also set VITE_APPCHECK_DEBUG_TOKEN=true and register the printed debug token in Console → App Check → Manage debug tokens
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=true
