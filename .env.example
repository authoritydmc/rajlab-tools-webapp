# App Check — reCAPTCHA Enterprise (hardcoded Enterprise key)
# Site key is public & hardcoded in src/firebaseConfig.jsx (6LfrIJMtAAAAAOcUqVTk_vsCTEGBF_bofvKJ7yhY — Enterprise).
# This is an ENTERPRISE key (grecaptcha.enterprise.execute) — must use ReCaptchaEnterpriseProvider.
# Previous 400 error was caused by using ReCaptchaV3Provider with this Enterprise key.
# To override, set VITE_RECAPTCHA_ENTERPRISE_SITE_KEY. For v3 keys use VITE_RECAPTCHA_V3_SITE_KEY.
# For local dev debug token: VITE_APPCHECK_DEBUG_TOKEN=true → register printed token in Console → App Check → Manage debug tokens
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=6LfrIJMtAAAAAOcUqVTk_vsCTEGBF_bofvKJ7yhY
VITE_APPCHECK_DEBUG_TOKEN=true
